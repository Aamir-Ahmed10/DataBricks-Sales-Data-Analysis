{
  "datasets": [
    {
      "name": "337c792b",
      "displayName": "Sale_Data_for_Dashboard",
      "queryLines": [
        "SELECT \r\n",
        "o.order_id, o.total_amount , o.customer_id, o.product_id, o.order_at,\r\n",
        "p.category,c.country_code\r\n",
        "FROM Orders o\r\n",
        "LEFT JOIN products p\r\n",
        "ON o.product_id = p.product_id\r\n",
        "LEFT JOIN customers c\r\n",
        "ON o.customer_id = c.customer_id"
      ],
      "catalog": "workspace",
      "schema": "sales_data"
    }
  ],
